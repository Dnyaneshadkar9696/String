public class Main
{
	public static void main(String[] args) {
	String ar = "Java is Programmin  Language";
		
		String word = "";
		String ans = "";
		
		char[] chr = ar.toCharArray();
		
		for(int i = 0 ; i < ar.length(); i++){
		    
		    char ch = chr[i];
		    
		    if(ch != ' '){
		        word = ch + word;
		    }
		    else{
		        ans += word + " ";
		        word = "";
		    }
		   
		    
     	}
     	 ans += word;
     	 System.out.println(ans);
	}
}
